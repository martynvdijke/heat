# HEAT environment configuration (example)
#
# Copy to .env and fill in real values. Never commit a populated .env.
# The server reads these variables directly; no secrets belong in this file.

# Deployment
DOCKER=true
PORT=6270
PUBLIC_BASE_URL=https://heat.vandijke.xyz

# Legal identity used by /privacy, /terms and /account/delete.
# These are published verbatim, so use the real controller's details.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_ADDRESS=
# Region where the server and its database are hosted, e.g. "the Netherlands".
LEGAL_HOSTING_REGION=the European Union

# Optional OIDC / Authelia login. Leave disabled unless configured.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# Prefer a mounted file; never commit the secret itself.
OIDC_CLIENT_SECRET_FILE=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_SCOPES=openid email profile groups
OIDC_LOGOUT_URL=

# Optional AI endpoints. When set, submitted text/images go to these services.
AI_TRACK_EXTRACT_URL=
AI_TEXT_GEN_URL=
AI_TEXT_GEN_MODEL=

# Optional OpenTelemetry exporter. Leave empty to use the database settings.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
