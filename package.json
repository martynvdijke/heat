{
  "name": "heat",
  "version": "1.54.2",
  "description": "A Go-based racing application with a web interface for managing racers, points, and race information. Built with a SQLite backend and served through a RESTful API.",
  "main": "index.js",
  "scripts": {
    "test": "go test ./...",
    "test:e2e": "npx playwright test",
    "build:frontend": "node build.mjs",
    "build:frontend:dev": "node build.mjs --dev",
    "typecheck": "tsc --noEmit",
    "build:ts": "tsc",
    "verify:sw-precache": "node scripts/verify-sw-precache.mjs",
    "verify:sw-precache:self-test": "node scripts/verify-sw-precache.mjs --self-test",
    "test:color": "node --test tests/color.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:martynvdijke/heat.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/martynvdijke/heat/issues"
  },
  "homepage": "https://github.com/martynvdijke/heat#readme",
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "bootstrap": "5.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.9",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.0"
  }
}
