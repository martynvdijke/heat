{
  "openapi": "3.0.3",
  "info": {
    "title": "HEAT Racing API",
    "description": "API for the HEAT: Pedal to the Metal racing championship management system",
    "version": "1.42.1",
    "contact": {
      "name": "HEAT Racing Federation"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Local server"
    }
  ],
  "paths": {
    "/api/check-setup": {
      "get": {
        "summary": "Check if admin is set up",
        "responses": {
          "200": {
            "description": "Setup status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "setup": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Login or create admin account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string", "example": "admin" },
                  "password": { "type": "string", "example": "password123" },
                  "setup": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "headers": {
              "Set-Cookie": {
                "description": "Session cookie",
                "schema": { "type": "string" }
              }
            }
          },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/logout": {
      "post": {
        "summary": "Logout and clear session",
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
    "/api/racers": {
      "get": {
        "summary": "Get all racers",
        "responses": {
          "200": {
            "description": "List of racers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Racer" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create or update a racer",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Racer" }
            }
          }
        },
        "responses": {
          "200": { "description": "Racer saved" },
          "401": { "description": "Unauthorized" }
        }
      },
      "delete": {
        "summary": "Delete a racer",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Racer deleted" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/race-info": {
      "get": {
        "summary": "Get current race info",
        "responses": {
          "200": {
            "description": "Race info",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RaceInfo" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update race info",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RaceInfoInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Race info updated" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/tracks": {
      "get": {
        "summary": "Get all tracks",
        "responses": {
          "200": {
            "description": "List of tracks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Track" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create or update a track",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Track" }
            }
          }
        },
        "responses": {
          "200": { "description": "Track saved" }
        }
      },
      "delete": {
        "summary": "Delete a track",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Track deleted" }
        }
      }
    },
    "/api/tracks/ai-extract": {
      "post": {
        "summary": "AI Track Extraction",
        "description": "Analyzes an image to extract race track GeoJSON (Alpha placeholder)",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Extracted GeoJSON",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/race-history": {
      "get": {
        "summary": "Get race history",
        "parameters": [
          { "name": "id", "in": "query", "schema": { "type": "integer" }, "description": "Specific race ID" }
        ],
        "responses": {
          "200": {
            "description": "Race history entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/RaceHistory" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Archive race to history",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RaceHistoryInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Race archived" },
          "401": { "description": "Unauthorized" }
        }
      },
      "delete": {
        "summary": "Delete race from history",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Race deleted" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/racer-stats": {
      "get": {
        "summary": "Get racer statistics",
        "parameters": [
          { "name": "id", "in": "query", "schema": { "type": "integer" }, "description": "Specific racer ID" }
        ],
        "responses": {
          "200": {
            "description": "Racer stats",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "type": "array", "items": { "$ref": "#/components/schemas/RacerStats" } },
                    { "type": "object", "properties": { "stats": { "$ref": "#/components/schemas/RacerStats" }, "racer": { "$ref": "#/components/schemas/Racer" } } }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/quotes": {
      "get": {
        "summary": "Get all quotes",
        "responses": {
          "200": {
            "description": "List of quotes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Quote" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a quote",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Quote" }
            }
          }
        },
        "responses": {
          "201": { "description": "Quote created" }
        }
      },
      "put": {
        "summary": "Update a quote",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Quote" }
            }
          }
        },
        "responses": {
          "200": { "description": "Quote updated" }
        }
      },
      "delete": {
        "summary": "Delete a quote",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Quote deleted" }
        }
      }
    },
    "/api/quote/random": {
      "get": {
        "summary": "Get a random quote",
        "responses": {
          "200": {
            "description": "Random quote",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Quote" }
              }
            }
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "summary": "Get application version",
        "responses": {
          "200": {
            "description": "Application version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": { "type": "string", "example": "1.2.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/upload": {
      "post": {
        "summary": "Upload an image",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UploadResponse" }
              }
            }
          },
          "400": { "description": "Invalid file type" }
        }
      }
    },
    "/api/oneoff-races": {
      "get": {
        "summary": "Get one-off race history",
        "responses": { "200": { "description": "One-off races", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/RaceHistory" } } } } } }
      },
      "delete": {
        "summary": "Delete a one-off race",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Deleted" }, "400": { "description": "ID required" } }
      }
    },
    "/api/track-stats": {
      "get": {
        "summary": "Get track performance statistics",
        "responses": { "200": { "description": "Track stats", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TrackStats" } } } } } }
      }
    },
    "/api/stats/head-to-head": {
      "get": {
        "summary": "Get head-to-head comparison",
        "parameters": [
          { "name": "racer1", "in": "query", "required": true, "schema": { "type": "integer" } },
          { "name": "racer2", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Head-to-head", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HeadToHead" } } } } }
      }
    },
    "/api/stats/points-progression": {
      "get": {
        "summary": "Get points progression for a racer",
        "parameters": [
          { "name": "racer_id", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Points progression", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/PointsProgression" } } } } } }
      }
    },
    "/api/stats/streaks": {
      "get": {
        "summary": "Get win/podium streaks",
        "responses": { "200": { "description": "Streaks", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/StreakInfo" } } } } } }
      }
    },
    "/api/stats/elo": {
      "get": {
        "summary": "Get ELO ratings",
        "responses": { "200": { "description": "ELO ratings", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ELORating" } } } } } }
      }
    },
    "/api/stats/export": {
      "get": {
        "summary": "Export stats as CSV",
        "responses": { "200": { "description": "CSV export", "content": { "text/csv": { "schema": { "type": "string" } } } } }
      }
    },
    "/api/stats/track-performance": {
      "get": {
        "summary": "Get racer performance by track",
        "parameters": [
          { "name": "racer_id", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Track performance data" } }
      }
    },
    "/api/notification-settings": {
      "get": {
        "summary": "Get notification settings",
        "security": [{ "cookieAuth": [] }],
        "responses": { "200": { "description": "Settings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationSettings" } } } } }
      },
      "post": {
        "summary": "Save notification settings",
        "security": [{ "cookieAuth": [] }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationSettings" } } } },
        "responses": { "200": { "description": "Saved" } }
      }
    },
    "/api/ai-settings": {
      "get": {
        "summary": "Get AI settings",
        "security": [{ "cookieAuth": [] }],
        "responses": { "200": { "description": "Settings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AISettings" } } } } }
      },
      "post": {
        "summary": "Save AI settings",
        "security": [{ "cookieAuth": [] }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AISettings" } } } },
        "responses": { "200": { "description": "Saved" } }
      }
    },
    "/api/email-settings": {
      "get": {
        "summary": "Get email settings",
        "security": [{ "cookieAuth": [] }],
        "responses": { "200": { "description": "Settings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmailSettings" } } } } }
      },
      "post": {
        "summary": "Save email settings",
        "security": [{ "cookieAuth": [] }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmailSettings" } } } },
        "responses": { "200": { "description": "Saved" } }
      }
    },
    "/api/racer-emails": {
      "get": {
        "summary": "Get racer emails",
        "security": [{ "cookieAuth": [] }],
        "responses": { "200": { "description": "Racer emails", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/RacerEmail" } } } } } }
      },
      "post": {
        "summary": "Save racer email",
        "security": [{ "cookieAuth": [] }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RacerEmail" } } } },
        "responses": { "200": { "description": "Saved" } }
      }
    },
    "/api/send-race-email": {
      "post": {
        "summary": "Send race result emails to racers",
        "security": [{ "cookieAuth": [] }],
        "responses": { "200": { "description": "Emails sent" }, "400": { "description": "Email not configured" } }
      }
    },
    "/api/test-notification": {
      "post": {
        "summary": "Send test notification via Gotify",
        "security": [{ "cookieAuth": [] }],
        "responses": { "200": { "description": "Test notification sent" }, "400": { "description": "Gotify not configured" } }
      }
    },
    "/api/umami-settings": {
      "get": {
        "summary": "Get analytics settings",
        "security": [{ "cookieAuth": [] }],
        "responses": { "200": { "description": "Settings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UmamiSettings" } } } } }
      },
      "post": {
        "summary": "Save analytics settings",
        "security": [{ "cookieAuth": [] }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UmamiSettings" } } } },
        "responses": { "200": { "description": "Saved" } }
      }
    },
    "/api/backup-settings": {
      "get": {
        "summary": "Get backup settings",
        "responses": { "200": { "description": "Settings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BackupSettings" } } } } }
      },
      "post": {
        "summary": "Save backup settings",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BackupSettings" } } } },
        "responses": { "200": { "description": "Saved" } }
      }
    },
    "/api/backup/manual": {
      "post": {
        "summary": "Create manual backup",
        "responses": { "200": { "description": "Backup created" }, "500": { "description": "Backup failed" } }
      }
    },
    "/api/backup/list": {
      "get": {
        "summary": "List recent backups",
        "responses": { "200": { "description": "Backup list", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "size": { "type": "integer" }, "time": { "type": "string" } } } } } } } }
      }
    },
    "/api/seasons": {
      "get": {
        "summary": "List all seasons",
        "responses": { "200": { "description": "Seasons", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Season" } } } } } }
      },
      "post": {
        "summary": "Create a new season",
        "security": [{ "cookieAuth": [] }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" } }, "required": ["name"] } } } },
        "responses": { "200": { "description": "Created" }, "400": { "description": "Name required" } }
      },
      "delete": {
        "summary": "Delete a season",
        "security": [{ "cookieAuth": [] }],
        "parameters": [{ "name": "id", "in": "query", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Deleted" } }
      }
    },
    "/api/seasons/archive": {
      "post": {
        "summary": "Archive a season",
        "security": [{ "cookieAuth": [] }],
        "parameters": [{ "name": "id", "in": "query", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Archived" }, "400": { "description": "ID required" } }
      }
    },
    "/api/rounds": {
      "post": {
        "summary": "Take a round snapshot",
        "security": [{ "cookieAuth": [] }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "race_name": { "type": "string" }, "season_id": { "type": "integer" } } } } } },
        "responses": { "200": { "description": "Snapshot taken", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoundSnapshot" } } } } }
      },
      "get": {
        "summary": "Get round snapshots",
        "parameters": [
          { "name": "id", "in": "query", "schema": { "type": "integer" } },
          { "name": "season_id", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Snapshots", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/RoundSnapshot" } } } } } }
      },
      "delete": {
        "summary": "Delete a round snapshot",
        "parameters": [{ "name": "id", "in": "query", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Deleted" } }
      }
    },
    "/api/flags": {
      "post": {
        "summary": "Send a race flag command",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FlagCommand" } } } },
        "responses": { "200": { "description": "Flag sent" }, "400": { "description": "Invalid flag" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "Racer": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "profile_picture": { "type": "string" },
          "car_color": { "type": "string" },
          "car_name": { "type": "string" },
          "points": { "type": "integer" },
          "rank": { "type": "integer" },
          "position": { "type": "integer" }
        }
      },
      "RaceInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "country": { "type": "string" },
          "track": { "type": "string" },
          "laps": { "type": "integer" },
          "track_id": { "type": "string" }
        }
      },
      "RaceInfoInput": {
        "type": "object",
        "properties": {
          "country": { "type": "string" },
          "track": { "type": "string" },
          "laps": { "type": "integer" },
          "track_id": { "type": "string" }
        }
      },
      "Track": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "monza" },
          "name": { "type": "string", "example": "Monza" },
          "country": { "type": "string", "example": "Italy" },
          "geojson": { "type": "string", "example": "monza" },
          "length_km": { "type": "integer", "example": 5 },
          "lap_record": { "type": "string", "example": "1:18.887" },
          "use_map_image": { "type": "boolean", "example": false },
          "map_image_url": { "type": "string", "example": "/static/images/map.png" },
          "refresh_geojson": { "type": "boolean", "example": true }
        }
      },
      "RaceResult": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "race_id": { "type": "integer" },
          "racer_id": { "type": "integer" },
          "racer_name": { "type": "string" },
          "position": { "type": "integer" },
          "points": { "type": "integer" },
          "fastest_lap": { "type": "boolean" },
          "finished": { "type": "boolean" }
        }
      },
      "RaceHistory": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "race_date": { "type": "string" },
          "country": { "type": "string" },
          "track": { "type": "string" },
          "track_id": { "type": "string" },
          "total_laps": { "type": "integer" },
          "race_type": { "type": "string", "example": "season" },
          "results": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RaceResult" }
          }
        }
      },
      "RaceHistoryInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "race_date": { "type": "string" },
          "country": { "type": "string" },
          "track": { "type": "string" },
          "track_id": { "type": "string" },
          "total_laps": { "type": "integer" },
