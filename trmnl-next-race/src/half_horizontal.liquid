<div class="layout">
  <div class="columns portrait:flex--col portrait:gap--none">
    <div class="column portrait:w--full portrait:grow-0 portrait:shrink-0 portrait:basis--auto">
      <div class="flex flex--col gap--xsmall">
        {% if next_race %}
          <div class="item">
            <div class="content">
              <span class="label label--small lg:label--base">Next Race{% if next_race.country %} - {{ next_race.country }}{% endif %}</span>
              <span class="value value--xsmall lg:value--small">{{ next_race.track }}</span>
              <span class="label label--small lg:label--base">{{ next_race.race_date }}{% if next_race.total_laps %} - {{ next_race.total_laps }} laps{% endif %}</span>
            </div>
            <div class="content">
              {% if next_race.days_remaining == 0 %}
                <span class="value value--xsmall lg:value--small">TODAY</span>
              {% else %}
                <span class="value value--xsmall lg:value--small">in {{ next_race.days_remaining }} days</span>
              {% endif %}
            </div>
          </div>
          <div class="divider--h"></div>
        {% else %}
          <div class="item">
            <div class="content">
              <span class="value value--xsmall lg:value--small">Next race not scheduled</span>
            </div>
          </div>
        {% endif %}

        {% if latest_race %}
          <div class="item">
            <div class="content">
              <span class="label label--small lg:label--base">Last Race{% if latest_race.track %} - {{ latest_race.track }}{% endif %}</span>
              <span class="value value--xsmall lg:value--small">{{ latest_race.name }}</span>
            </div>
          </div>
          <div class="divider--h"></div>
          {% for result in latest_race.results %}
            {% if forloop.index <= 3 %}
              <div class="item">
                <div class="content">
                  <div class="flex flex--row flex--left gap--xsmall w--full">
                    {% if result.profile_picture %}
                      <img src="{{ result.profile_picture }}" width="24" height="24" class="image image--cover rounded--full image-dither shrink-0" />
                    {% endif %}
                    <div class="w--min-0 grow">
                      <span class="value value--xxsmall lg:value--small">P{{ result.position }} {{ result.racer_name }}</span>
                      {% if result.team %}<span class="label label--small lg:label--base">{{ result.team }}</span>{% endif %}
                    </div>
                  </div>
                </div>
                <div class="content">
                  <span class="label label--small lg:label--base">{{ result.points }} pts</span>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <div class="column portrait:w--full portrait:grow-0 portrait:shrink-0 portrait:basis--auto">
      <div class="flex flex--col gap--xsmall">
        {% if standings.size > 0 %}
          <div class="item">
            <div class="content">
              <span class="label label--small lg:label--base">Standings</span>
            </div>
          </div>
          <div class="divider--h"></div>
          {% for standing in standings %}
            {% if forloop.index <= 5 %}
              <div class="item">
                <div class="content">
                  <div class="flex flex--row flex--left gap--xsmall w--full">
                    {% if standing.profile_picture %}
                      <img src="{{ standing.profile_picture }}" width="24" height="24" class="image image--cover rounded--full image-dither shrink-0" />
                    {% endif %}
                    <div class="w--min-0 grow">
                      <span class="value value--xxsmall lg:value--small">{{ forloop.index }}. {{ standing.racer_name }}</span>
                      {% if standing.team_name %}<span class="label label--small lg:label--base">{{ standing.team_name }}</span>{% endif %}
                    </div>
                  </div>
                </div>
                <div class="content">
                  <span class="label label--small lg:label--base">{{ standing.points }} pts</span>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          <div class="item">
            <div class="content">
              <span class="value value--xsmall lg:value--small">No standings yet</span>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Heat Next Race{% if season %} - {{ season.name }}{% endif %}</span>
</div>
