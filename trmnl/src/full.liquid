<div class="layout layout--col gap--xsmall">
  {% if latest_race %}
    <div class="item">
      <div class="content">
        <span class="label label--small lg:label--base">Round {{ latest_race.round }}{% if latest_race.track %} - {{ latest_race.track }}{% if latest_race.country %}, {{ latest_race.country }}{% endif %}{% endif %}</span>
        <span class="value value--small lg:value--large">{{ latest_race.name }}</span>
        <span class="label label--small lg:label--base">{{ latest_race.race_date }}{% if latest_race.total_laps %} - {{ latest_race.total_laps }} laps{% endif %}</span>
      </div>
    </div>
    <div class="divider--h"></div>
    <div class="grid grid--cols-2 lg:grid--cols-4 lg:portrait:grid--cols-2 gap--xsmall">
      {% for result in latest_race.results %}
        <div class="item">
          <div class="content">
            <div class="flex flex--row flex--left gap--xsmall w--full">
              {% if result.profile_picture %}
                <img src="{{ result.profile_picture }}" width="28" height="28" class="image image--cover rounded--full image-dither shrink-0" />
              {% endif %}
              <div class="w--min-0 grow">
                <span class="value value--xxsmall lg:value--small">P{{ result.position }} {{ result.racer_name }}</span>
                {% if result.team %}<span class="label label--small lg:label--base">{{ result.team }}</span>{% endif %}
              </div>
            </div>
          </div>
          <div class="content">
            <span class="label label--small lg:label--base">{{ result.points }} pts</span>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="item">
      <div class="content">
        <span class="value value--xsmall lg:value--small">No race data yet</span>
      </div>
    </div>
  {% endif %}

  {% if standings.size > 0 %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="label label--small lg:label--base">Standings</span>
      </div>
    </div>
    <div class="grid grid--cols-2 lg:grid--cols-4 lg:portrait:grid--cols-2 gap--xsmall">
      {% for standing in standings %}
        <div class="item">
          <div class="content">
            <div class="flex flex--row flex--left gap--xsmall w--full">
              {% if standing.profile_picture %}
                <img src="{{ standing.profile_picture }}" width="28" height="28" class="image image--cover rounded--full image-dither shrink-0" />
              {% endif %}
              <div class="w--min-0 grow">
                <span class="value value--xxsmall lg:value--small">{{ forloop.index }}. {{ standing.racer_name }}</span>
                {% if standing.team_name %}<span class="label label--small lg:label--base">{{ standing.team_name }}</span>{% endif %}
              </div>
            </div>
          </div>
          <div class="content">
            <span class="label label--small lg:label--base">{{ standing.points }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  {% elsif latest_race == nil %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="value value--xsmall lg:value--small">No race data yet</span>
      </div>
    </div>
  {% else %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="value value--xsmall lg:value--small">No standings yet</span>
      </div>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Heat Championship{% if season %} - {{ season.name }}{% endif %}</span>
</div>
