<div class="layout layout--col gap--xsmall">
  {% if latest_race %}
    <div class="item">
      <div class="content">
        <span class="label label--small">Round {{ latest_race.round }}{% if latest_race.track %} - {{ latest_race.track }}{% if latest_race.country %}, {{ latest_race.country }}{% endif %}{% endif %}</span>
        <span class="value value--small">{{ latest_race.name }}</span>
        <span class="label label--small">{{ latest_race.race_date }}{% if latest_race.total_laps %} - {{ latest_race.total_laps }} laps{% endif %}</span>
      </div>
    </div>
    <div class="divider--h"></div>
    <div class="grid grid--cols-2 gap--xsmall">
      {% for result in latest_race.results %}
        <div class="item">
          <div class="content">
            <span class="value value--xxsmall">P{{ result.position }} {{ result.racer_name }}</span>
            {% if result.team %}<span class="label label--small">{{ result.team }}</span>{% endif %}
          </div>
          <div class="content">
            <span class="label label--small">{{ result.points }} pts</span>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No race data yet</span>
      </div>
    </div>
  {% endif %}

  {% if standings.size > 0 %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="label label--small">Standings</span>
      </div>
    </div>
    <div class="grid grid--cols-2 gap--xsmall">
      {% for standing in standings %}
        <div class="item">
          <div class="content">
            <span class="value value--xxsmall">{{ forloop.index }}. {{ standing.racer_name }}</span>
          </div>
          <div class="content">
            <span class="label label--small">{{ standing.points }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  {% elsif latest_race == nil %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No race data yet</span>
      </div>
    </div>
  {% else %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No standings yet</span>
      </div>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Heat Championship{% if season %} - {{ season.name }}{% endif %}</span>
</div>
