<div class="columns">
  <div class="column">
    <div class="layout layout--col gap--xsmall">
      {% if latest_race %}
        <div class="item">
          <div class="content">
            <span class="label label--small">Round {{ latest_race.round }}{% if latest_race.track %} - {{ latest_race.track }}{% endif %}</span>
            <span class="value value--xsmall">{{ latest_race.name }}</span>
          </div>
        </div>
        <div class="divider--h"></div>
        {% for result in latest_race.results %}
          {% if forloop.index <= 3 %}
            <div class="item">
              <div class="content">
                <span class="value value--xxsmall">P{{ result.position }} {{ result.racer_name }}</span>
                {% if result.team %}<span class="label label--small">{{ result.team }}</span>{% endif %}
              </div>
              <div class="content">
                <span class="label label--small">{{ result.points }} pts</span>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="item">
          <div class="content">
            <span class="value value--xsmall">No race data yet</span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="column">
    <div class="layout layout--col gap--xsmall">
      {% if standings.size > 0 %}
        <div class="item">
          <div class="content">
            <span class="label label--small">Standings</span>
          </div>
        </div>
        <div class="divider--h"></div>
        {% for standing in standings %}
          {% if forloop.index <= 3 %}
            <div class="item">
              <div class="content">
                <span class="value value--xxsmall">{{ forloop.index }}. {{ standing.racer_name }}</span>
              </div>
              <div class="content">
                <span class="label label--small">{{ standing.wins }} wins - {{ standing.points }} pts</span>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="item">
          <div class="content">
            <span class="value value--xsmall">No standings yet</span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Heat{% if season %} - {{ season.name }}{% endif %}</span>
</div>
