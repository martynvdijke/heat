<div class="layout layout--col gap--xsmall">
  {% if latest_race %}
    <div class="item">
      <div class="content">
        <span class="label label--small">Round {{ latest_race.round }}{% if latest_race.track %} - {{ latest_race.track }}{% endif %}</span>
        <span class="value value--xsmall">{{ latest_race.name }}</span>
        <span class="label label--small">{{ latest_race.race_date }}</span>
      </div>
    </div>
    <div class="divider--h"></div>
    {% for result in latest_race.results %}
      {% if forloop.index <= 3 %}
        <div class="item">
          <div class="content">
            <div class="layout layout--row align--center gap--xsmall">
              {% if result.profile_picture %}
                <img src="{{ result.profile_picture }}" width="24" height="24" />
              {% endif %}
                  <span class="value value--xxsmall">P{{ result.position }} {{ result.racer_name }}</span>
                  {% if result.team %}<span class="label label--small">{{ result.team }}</span>{% endif %}
            </div>
          </div>
          <div class="content">
            <span class="label label--small">{{ result.points }} pts</span>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  {% else %}
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No race data yet</span>
      </div>
    </div>
  {% endif %}

  {% if standings.size > 0 %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="label label--small">Standings</span>
      </div>
    </div>
    {% for standing in standings %}
      {% if forloop.index <= 3 %}
        <div class="item">
          <div class="content">
            <div class="layout layout--row align--center gap--xsmall">
              {% if standing.profile_picture %}
                <img src="{{ standing.profile_picture }}" width="24" height="24" />
              {% endif %}
              <span class="value value--xxsmall">{{ forloop.index }}. {{ standing.racer_name }}</span>
            </div>
          </div>
          <div class="content">
            <span class="label label--small">{{ standing.points }} pts</span>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  {% elsif latest_race == nil %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No race data yet</span>
      </div>
    </div>
  {% else %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No standings yet</span>
      </div>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Heat{% if season %} - {{ season.name }}{% endif %}</span>
</div>
