<div class="layout layout--col gap--xsmall">
  {% if latest_race %}
    {% for result in latest_race.results %}
        {% if forloop.index <= 3 %}
          <div class="item">
            <div class="content">
              <div style="display:flex;align-items:center;gap:6px;width:100%;">
                {% if result.profile_picture %}
                  <img src="{{ result.profile_picture }}" width="24" height="24" style="border-radius:50%;object-fit:cover;flex-shrink:0;" />
                {% endif %}
                <div style="min-width:0;">
                  <span class="value value--xxsmall">P{{ result.position }} {{ result.racer_name }}</span>
                  {% if result.team %}<span class="label label--small">{{ result.team }}</span>{% endif %}
                </div>
              </div>
            </div>
            <div class="content">
              <span class="label label--small">{{ result.points }} pts</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
  {% else %}
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No race data yet</span>
      </div>
    </div>
  {% endif %}

  {% if standings.size > 0 %}
    <div class="divider--h"></div>
    {% for standing in standings %}
      {% if forloop.index <= 3 %}
        <div class="item">
          <div class="content">
            <div style="display:flex;align-items:center;gap:6px;width:100%;">
              {% if standing.profile_picture %}
                <img src="{{ standing.profile_picture }}" width="24" height="24" style="border-radius:50%;object-fit:cover;flex-shrink:0;" />
              {% endif %}
              <span class="value value--xxsmall">{{ forloop.index }}. {{ standing.racer_name }}</span>
            </div>
          </div>
          <div class="content">
            <span class="label label--small">{{ standing.points }} pts</span>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  {% elsif latest_race == nil %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No race data yet</span>
      </div>
    </div>
  {% else %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No standings yet</span>
      </div>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Heat{% if season %} - {{ season.name }}{% endif %}</span>
</div>
