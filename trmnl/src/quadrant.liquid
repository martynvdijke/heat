<div class="layout layout--col gap--xsmall">
  {% if latest_race %}
    {% for result in latest_race.results %}
        {% if forloop.index <= 3 %}
          <div class="item">
            <div class="content">
              <div class="flex flex--row flex--left gap--xsmall w--full">
                {% if result.profile_picture %}
                  <img src="{{ result.profile_picture }}" width="24" height="24" class="image image--cover rounded--full image-dither shrink-0" />
                {% endif %}
                <div class="w--min-0 grow">
                  <span class="value value--xxsmall lg:value--small">P{{ result.position }} {{ result.racer_name }}</span>
                  {% if result.team %}<span class="label label--small">{{ result.team }}</span>{% endif %}
                </div>
              </div>
            </div>
            <div class="content">
              <span class="label label--small">{{ result.points }} pts</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
  {% else %}
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No race data yet</span>
      </div>
    </div>
  {% endif %}

  {% if standings.size > 0 %}
    <div class="divider--h"></div>
    {% for standing in standings %}
      {% if forloop.index <= 3 %}
        <div class="item">
          <div class="content">
            <div class="flex flex--row flex--left gap--xsmall w--full">
              {% if standing.profile_picture %}
                <img src="{{ standing.profile_picture }}" width="24" height="24" class="image image--cover rounded--full image-dither shrink-0" />
              {% endif %}
              <div class="w--min-0 grow">
                <span class="value value--xxsmall lg:value--small">{{ forloop.index }}. {{ standing.racer_name }}</span>
                {% if standing.team_name %}<span class="label label--small">{{ standing.team_name }}</span>{% endif %}
              </div>
            </div>
          </div>
          <div class="content">
            <span class="label label--small">{{ standing.points }} pts</span>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  {% elsif latest_race == nil %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No race data yet</span>
      </div>
    </div>
  {% else %}
    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No standings yet</span>
      </div>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Heat{% if season %} - {{ season.name }}{% endif %}</span>
</div>
